# Copy to a local, non-committed config mechanism as documented in README.
# NEVER commit real keys. NEVER put service_role keys in frontend code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional frontend settings (also set these in js/supabase-config.js):
# SUPABASE_ENQUIRY_FUNCTION=submit-enquiry
# TURNSTILE_SITE_KEY=

# Service role key is for server-side/Edge Functions only (never frontend).
# It is normally injected automatically by Supabase into Edge Functions.
# SUPABASE_SERVICE_ROLE_KEY=...

# Optional Edge Function secrets (set with `supabase secrets set`):
# TURNSTILE_SECRET_KEY=
# RATE_LIMIT_SALT=
# ALLOWED_ORIGINS=https://yourdomain.com
